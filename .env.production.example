# AvPocket Production Environment Variables
# ⚠️ IMPORTANT: Change ALL values below before deploying!
# Copy this file: cp .env.production.example .env.production

# ── Database ──
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password_here

# ── Authentication ──
JWT_SECRET=CHANGE_ME_at_least_64_characters_of_random_alphanumeric_text_here

# ── Application ──
NEXT_PUBLIC_APP_URL=https://av-api.ir
UPLOAD_DIR=/app/storage/uploads

# ── GitHub CI Webhook ──
GITHUB_WEBHOOK_SECRET=CHANGE_ME_your_github_webhook_secret

# ── Redis ──
REDIS_URL=redis://redis:6379
